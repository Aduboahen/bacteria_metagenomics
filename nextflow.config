conda.enabled = true
conda.useMamba = true
workDir = "${launchDir}/scratch"
resume = true

env {
    GTDBTK_DATA_PATH = "${params.dbdir}/databases/release_226"
}

params {
    // Pipeline Inputs/Outputs
    inputdir = "${launchDir}/input"
    outdir = "${launchDir}/results"
    dbdir = "${launchDir}/databases"
    toolsdir = "${launchDir}/tools"
    envsdir = "${launchDir}/envs"
    conda_root = "${System.getenv('HOME')}/.miniconda/envs"

    // Run settings
    run_date = new Date().format('dd_MM')

    // Databases
    KRAKEN2DB = "${params.dbdir}/k2_standard_16_GB_20250714"
    CHECKMDB = "${params.dbdir}/CheckM2_database/uniref100.KO.1.dmnd"
    hosts = "${params.dbdir}/hosts/GCF_016699485.2_bGalGal1.mat.broiler.GRCg7b_genomic.fna.gz"

    // Scripts
    vamb_env = "${params.toolsdir}/vamb_env/bin/activate"
    vamb_concat = "${params.toolsdir}/vamb_scripts/src/concatenate.py"
    format_abricate = "${params.toolsdir}/format_abricate.py"


    // Filtering Parameters
    base_quality = 8
    read_length = 1000
    bin_size = 100000
}

process {
    // default environment
    conda = '$HOME/.miniconda3/envs/bacteria_meta'

    withName: 'taxa_assign_assembly:FLYE_ASSEMBLE' {
        conda = '$HOME/.miniconda/envs/meta_assembler'
    }

    withName: 'bin_classify:CHECKM2_BIN_QC' {
        conda = '$HOME/.miniconda/envs/checkm2'
    }

    withName: 'bin_classify:GTDB_CLASSIFY' {
        conda = '$HOME/.miniconda/envs/gtdbtk-2.6.1'
    }
}

process {
    // Default environment
    conda = "${params.conda_root}/bacteria_meta"

    withName: 'taxa_assign_assembly:FLYE_ASSEMBLE' {
        conda = "${params.envsdir}/meta_assembler.yml"
    }

    withName: 'bin_classify:CHECKM2_BIN_QC' {
        conda = "${params.conda_root}/checkm2"
    }

    withName: 'bin_classify:GTDB_CLASSIFY' {
        conda = "${params.conda_root}/gtdbtk-2.6.1"
        memory = 64.GB
        when = false
    }
}

profiles {
    standard {
        process.executor = 'local'
        executor.queueSize = 100
        process.cpus = 8
        process.memory = 8.GB
    }

    slurm {
        process.executor = 'slurm'
        process.cpus = 15
        process.memory = 8.GB
        executor.queueSize = 100
    }
}
