conda.enabled = true
conda.useMamba = true
workDir = env("SCRATCH")

resume = true

params {
    // Pipeline Inputs/Outputs
    inputdir = "${launchDir}/input"
    outdir = "${launchDir}/results"
    dbdir = env("DBDIR")
    toolsdir = "${launchDir}/tools"
    envsdir = "${launchDir}/envs"

    // Run settings
    run_date = new Date().format('dd_MM')

    // Databases
    KRAKEN2DB = env("KRAKEN2_DB_PATH")
    CHECKMDB = "${params.dbdir}/CheckM2_database/uniref100.KO.1.dmnd"
    hosts = "${launchDir}/hosts/homo_bos_taurus_gallus_gallus.fasta"

    // Scripts
    vamb_concat = "${params.toolsdir}/vamb_scripts/src/concatenate.py"
    format_abricate = "${params.toolsdir}/format_abricate.py"


    // Filtering Parameters
    base_quality = 8
    read_length = 1000
    bin_size = 100000
}

process {
    // default environment
    conda = "${params.envsdir}/main.yml"

    withName: 'taxa_assign_assembly:FLYE_ASSEMBLE' {
        conda = "${params.envsdir}/flye.yml"
    }

    withName: KRAKEN2_ASSIGN_TAXA {
        memory = 120.GB 
    }

    withName: 'bin_classify:CHECKM2_BIN_QC' {
        conda = "${params.envsdir}/checkm2.yml"
    }

    withName: 'bin_classify:GTDB_CLASSIFY' {
        conda = "${params.envsdir}/gtdbtk.yml"
        memory = 120.GB 
    }
    withName: VAMB_CONCAT {
        conda = "${params.envsdir}/vamb.yml"
    }
    withName: VAMB_BINNING {
        conda = "${params.envsdir}/vamb.yml"
    }
    withName: MINIMAP2_REMOVE_HOST_READS {
        memory = { 8.GB * task.attempt}
    }
    withName: FLYE_ASSEMBLE {
       memory = { 8.GB * task.attempt }
    }
    withName: CHECKM2_BIN_QC {
       memory = { 16.GB * task.attempt }
       errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus = 8
        process.memory = 8.GB
        process.publishDir = [mode: 'link']
    }

    slurm {
        process.executor = 'slurm'
        process.cpus = 15
        process.memory = 8.GB
        executor.queueSize = 100
        process.publishDir = [mode: 'copy']
        env {
            KRAKEN2_DB_PATH = System.getenv('KRAKEN2_DB_PATH')
            GTDBTK_DATA_PATH = System.getenv('GTDBTK_DATA_PATH')
        }
    }
}
